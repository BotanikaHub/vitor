{%- comment -%}
  ============================================================
  Barra superior de confiança (marquee).

  Ritmo: um benefício, uma frase da marca, um benefício, uma
  frase da marca. A alternância é o que separa as mensagens —
  não existe ponto nem estrela entre elas. O único símbolo é o
  que fica DENTRO da frase da marca, entre as duas metades.

  A frase da marca é visivelmente maior que o benefício. É ela
  que carrega a voz da marca; o benefício é informação.
  ============================================================
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign items = section.blocks
-%}
{%- capture fs_norm -%}{%- render 'botanika-freeship-weekend', mode: 'normal_label' -%}{%- endcapture -%}
{%- capture fs_lbl -%}{%- render 'botanika-freeship-weekend', mode: 'label' -%}{%- endcapture -%}
{%- assign fs_norm = fs_norm | strip -%}
{%- assign fs_lbl = fs_lbl | strip -%}
{%- if items.size > 0 -%}
  <div
    class="ttb{% if st.hide_mobile %} ttb--desk-only{% endif %}"
    style="--ttb-bg:{{ st.bg_color }};--ttb-text:{{ st.text_color }};--ttb-accent:{{ st.accent_color }};--ttb-speed:{{ st.speed }}s;--ttb-gap:{{ st.gap }}px;--ttb-size:{{ st.font_size }}px;--ttb-brand-scale:{{ st.brand_scale }};"
  >
    <div class="ttb__viewport">
      <div class="ttb__track">
        {%- for pass in (1..2) -%}
          <div class="ttb__group"{% if pass == 2 %} aria-hidden="true"{% endif %}>
            {%- for block in items -%}
              {%- if block.settings.text != blank -%}

                {%- if block.type == 'brand_phrase' -%}
                  <span class="ttb__item ttb__item--brand" {{ block.shopify_attributes }}>
                    <span class="ttb__brand">
                      {%- assign partes = block.settings.text | split: '|' -%}
                      {%- if partes.size > 1 -%}
                        <span>{{ partes[0] | strip }}</span>
                        <span class="ttb__glifo">
                          {%- render 'botanika-trust-icon', nome: block.settings.glifo, tamanho: 15 -%}
                        </span>
                        <span>{{ partes[1] | strip }}</span>
                      {%- else -%}
                        <span>{{ block.settings.text }}</span>
                      {%- endif -%}
                    </span>
                  </span>

                {%- else -%}
                  <span class="ttb__item" {{ block.shopify_attributes }}>
                    {%- if block.settings.icone != 'nenhum' -%}
                      <span class="ttb__icon">
                        {%- render 'botanika-trust-icon', nome: block.settings.icone -%}
                      </span>
                    {%- endif -%}
                    <span class="ttb__text">{{ block.settings.text | replace: fs_norm, fs_lbl }}</span>
                  </span>
                {%- endif -%}

              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- style -%}
    {%- comment -%}
      font_face devolve uma regra CSS, não HTML. Fora de um bloco de
      estilo ela aparece como texto na página — foi o que aconteceu.
    {%- endcomment -%}
    {%- if st.brand_font != blank -%}
      {{ st.brand_font | font_face: font_display: 'swap' }}
      .ttb__brand {
        font-family: {{ st.brand_font.family }}, {{ st.brand_font.fallback_families }};
        font-weight: {{ st.brand_font.weight }};
        font-style: {{ st.brand_font.style }};
      }
    {%- endif -%}

    .ttb {
      background: var(--ttb-bg);
      color: var(--ttb-text);
      overflow: hidden;
      font-size: var(--ttb-size);
      font-weight: 600;
      line-height: 1;
      contain: content;
    }
    .ttb__viewport { overflow: hidden; }
    .ttb__track {
      display: flex;
      width: max-content;
      animation: ttb-scroll var(--ttb-speed) linear infinite;
      will-change: transform;
    }
    .ttb:hover .ttb__track { animation-play-state: paused; }

    /* A altura vem do item mais alto, que é a frase da marca. O padding
       é o respiro em volta dela, não em volta do texto pequeno. */
    .ttb__group { display: flex; align-items: center; padding: 12px 0; }

    .ttb__item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
      padding-inline: calc(var(--ttb-gap) / 2);
    }
    .ttb__icon { display: inline-flex; line-height: 0; opacity: .92; }
    .ttb__ico { display: block; }

    .ttb__brand {
      display: inline-flex;
      align-items: center;
      gap: .42em;
      font-size: calc(1em * var(--ttb-brand-scale));
      font-weight: 700;
      letter-spacing: .005em;
      text-transform: uppercase;
      color: var(--ttb-accent);
      white-space: nowrap;
    }
    .ttb__glifo { display: inline-flex; line-height: 0; }
    .ttb__glifo .ttb__ico { stroke-width: 2.1; }

    @keyframes ttb-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    @media (max-width: 749px) {
      .ttb { -webkit-text-size-adjust: 100%; }
      .ttb__group { padding: 10px 0; }
      .ttb__item { gap: 7px; padding-inline: calc(var(--ttb-gap) / 3); }
      .ttb__ico { width: 16px; height: 16px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .ttb__track { animation: none; }
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Barra de confiança (topo)",
  "class": "section-top-trust-bar",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "range", "id": "speed", "min": 15, "max": 120, "step": 5, "unit": "s", "label": "Velocidade (quanto maior, mais lento)", "default": 70 },
    { "type": "range", "id": "gap", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Espaço entre mensagens", "default": 70 },
    { "type": "range", "id": "font_size", "min": 11, "max": 18, "step": 1, "unit": "px", "label": "Tamanho do texto de benefício", "default": 14 },
    { "type": "range", "id": "brand_scale", "min": 1.0, "max": 1.8, "step": 0.1, "label": "Frase da marca — quantas vezes maior", "default": 1.4 },
    { "type": "header", "content": "Fonte da marca" },
    {
      "type": "font_picker",
      "id": "brand_font",
      "label": "Fonte das frases da marca",
      "info": "Substituta enquanto a fonte da logo não estiver no tema. Com o arquivo da fonte original, as frases ficam idênticas à logo.",
      "default": "archivo_n7"
    },
    { "type": "header", "content": "Cores" },
    { "type": "color", "id": "bg_color", "label": "Cor de fundo", "default": "#323C91" },
    { "type": "color", "id": "text_color", "label": "Cor do texto", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Cor das frases da marca", "default": "#C4D78A" },
    { "type": "checkbox", "id": "hide_mobile", "label": "Ocultar no mobile", "default": false }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Benefício",
      "settings": [
        {
          "type": "select",
          "id": "icone",
          "label": "Ícone",
          "options": [
            { "value": "folha", "label": "Folha" },
            { "value": "selo", "label": "Selo de certificação" },
            { "value": "caminhao", "label": "Caminhão" },
            { "value": "cadeado", "label": "Cadeado" },
            { "value": "estrela", "label": "Estrela" },
            { "value": "frasco", "label": "Frasco" },
            { "value": "pulso", "label": "Pulso (curadoria médica)" },
            { "value": "escudo", "label": "Escudo" },
            { "value": "coracao", "label": "Coração" },
            { "value": "raio", "label": "Raio" },
            { "value": "nenhum", "label": "Sem ícone" }
          ],
          "default": "folha"
        },
        { "type": "text", "id": "text", "label": "Texto", "default": "Entregamos para todo o Brasil" }
      ]
    },
    {
      "type": "brand_phrase",
      "name": "Frase da marca",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Frase",
          "info": "Use | para separar as duas metades — o símbolo entra no meio. Ex: SUPLEMENTO | DE VERDADE",
          "default": "BOTANIKA | BRASIL"
        },
        {
          "type": "select",
          "id": "glifo",
          "label": "Símbolo do meio",
          "options": [
            { "value": "brilho", "label": "Brilho" },
            { "value": "folha", "label": "Folha" },
            { "value": "estrela", "label": "Estrela" },
            { "value": "coracao", "label": "Coração" },
            { "value": "raio", "label": "Raio" }
          ],
          "default": "brilho"
        }
      ]
    }
  ],
  "max_blocks": 14,
  "presets": [
    {
      "name": "Barra de confiança (topo)",
      "blocks": [
        { "type": "trust_item", "settings": { "icone": "pulso", "text": "Fórmulas com curadoria médica" } },
        { "type": "brand_phrase", "settings": { "text": "SUPLEMENTO | DE VERDADE", "glifo": "brilho" } },
        { "type": "trust_item", "settings": { "icone": "estrela", "text": "97% de clientes satisfeitos" } },
        { "type": "brand_phrase", "settings": { "text": "VIVA MAIS | E MELHOR", "glifo": "brilho" } },
        { "type": "trust_item", "settings": { "icone": "caminhao", "text": "Frete grátis acima de R$349" } },
        { "type": "brand_phrase", "settings": { "text": "CIÊNCIA | E NATUREZA", "glifo": "brilho" } },
        { "type": "trust_item", "settings": { "icone": "cadeado", "text": "Compra 100% segura" } },
        { "type": "brand_phrase", "settings": { "text": "BOTANIKA | BRASIL", "glifo": "brilho" } },
        { "type": "trust_item", "settings": { "icone": "selo", "text": "Suplementos com certificação ANVISA" } },
        { "type": "brand_phrase", "settings": { "text": "SAÚDE | TODO DIA", "glifo": "brilho" } }
      ]
    }
  ]
}
{% endschema %}
