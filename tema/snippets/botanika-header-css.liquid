{%- comment -%}
  ============================================================
  Cabeçalho e menu lateral — identidade Botanika.

  Renderizado por snippets/toggle-menu.liquid, presente no
  cabeçalho de todas as páginas.
  ============================================================
{%- endcomment -%}
<style>
  :root {
    --bk-azul: #323C91;
    --bk-azul-esc: #1B2560;
    --bk-verde: #C4D78A;
    --bk-logo-mobile: 220px;
    --bk-logo-desktop: 140px;
  }

  /* ---------- Logo ---------- */
  /* A width é alta de propósito: quem manda é o max-width:100%, que
     prende a logo na célula dela. Assim ela fica sempre no maior
     tamanho possível sem invadir a busca. */
  .header__logo { min-width: 0; }
  .header .header__logo .header__normal-logo img {
    width: var(--bk-logo-mobile) !important;
    max-width: 100% !important;
    height: auto !important;
  }
  @media (min-width: 768px) {
    .header .header__logo .header__normal-logo img {
      width: var(--bk-logo-desktop) !important;
      max-width: var(--bk-logo-desktop) !important;
    }
  }

  /* ---------- Ícones ---------- */
  .header .header-color,
  .header .header-icon,
  .header .nav-toggle { color: var(--bk-azul); }

  .header__action .header-icon svg,
  .header__action a > svg,
  .header__action button > svg { width: 19px !important; height: auto !important; }

  .header .nav-toggle > svg {
    width: 24px !important;
    height: 16px !important;
    color: var(--bk-azul);
  }

  /* Espaço para a logo: estreita os botões sem mexer na altura,
     que é o que importa no toque. */
  @media (max-width: 767px) {
    .header header-inner { gap: 4px !important; }
    .header .nav-toggle.w-44,
    .header__action .w-44 { width: 38px !important; }
  }

  /* ---------- Contador do carrinho ---------- */
  #cart-icon-bubble .cart-count {
    box-sizing: border-box;
    background: var(--bk-verde) !important;
    color: var(--bk-azul) !important;
    font-weight: 700;
    font-size: 10.5px;
    min-width: 18px;
    height: 18px;
    padding-inline: 4px;
    border-radius: 9px;
    box-shadow: 0 0 0 2px var(--color-background, #fff);
  }

  .transparent .header-color,
  .transparent .header-icon,
  .transparent .nav-toggle { color: inherit; }

  /* ================= MENU LATERAL (mobile) ================= */
  /* A cor da barra do topo vem da configuração menu_mobile_background
     do cabeçalho, não daqui — ela virou o azul da marca no
     header-group.json. Aqui é só o acabamento. */
  @media (max-width: 1024.98px) {
    .menu-mobile-title { min-height: 62px !important; }
    .menu-mobile-title a.active {
      font-size: 17px;
      letter-spacing: .005em;
    }

    /* Itens com mais respiro e na cor da marca. O menu é a segunda
       tela mais vista do site no celular; texto miúdo aqui custa
       navegação. */
    .horizontal-list > li.level0 > menu-item > a {
      font-size: 15.5px !important;
      font-weight: 600 !important;
      color: var(--bk-azul-esc) !important;
    }
    .horizontal-list > li.level0 > menu-item {
      border-color: rgba(50, 60, 145, .13) !important;
    }
    open-children-toggle svg.icon-down { color: var(--bk-azul); opacity: .5; }

    /* Entrar / Cadastrar deixa de ser mais um item da lista e vira
       botão — é ação, não navegação. */
    .horizontal-list a.account-login,
    .horizontal-list a.account-url {
      margin: 20px 0 8px !important;
      border: 1.5px solid var(--bk-azul) !important;
      border-radius: 999px !important;
      min-height: 48px !important;
      justify-content: center !important;
      color: var(--bk-azul) !important;
      font-weight: 700 !important;
      gap: 8px;
    }
    .horizontal-list a.account-login svg,
    .horizontal-list a.account-url svg { color: var(--bk-azul); }
  }
</style>
