    {%- when 'raio' -%}
      <path d="M13.4 2.8 4.6 13.6h6.2l-1.2 7.6 8.8-10.8h-6.2z"/>

    {%- when 'lua' -%}
      <path d="M20.4 14.5A8.9 8.9 0 0 1 9.5 3.6a8.9 8.9 0 1 0 10.9 10.9Z"/>

    {%- when 'chama' -%}
