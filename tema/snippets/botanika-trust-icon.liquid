    {%- when 'marte' -%}
      <circle cx="10.2" cy="13.8" r="5.1"/>
      <path d="m14.2 9.8 6.3-6.3M15.4 3.5h5.1v5.1"/>

    {%- when 'flor' -%}
      <circle cx="12" cy="7.2" r="3"/>
      <circle cx="12" cy="16.8" r="3"/>
      <circle cx="7.2" cy="12" r="3"/>
      <circle cx="16.8" cy="12" r="3"/>
      <circle cx="12" cy="12" r="1.7"/>

    {%- when 'capsula' -%}
      <rect x="2.9" y="8.4" width="18.2" height="7.2" rx="3.6"/>
