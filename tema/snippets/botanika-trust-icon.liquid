      <circle cx="12" cy="12" r="4.1"/>
      <path d="M17.1 6.9h.01"/>

    {%- when 'aspas' -%}
      <path d="M9.6 5.6C6.6 7 4.9 9.5 4.9 13v5.4h6.4V13H8.2c0-2.4.9-4.1 2.7-5.1zM20.4 5.6c-3 1.4-4.7 3.9-4.7 7.4v5.4h6.4V13H19c0-2.4.9-4.1 2.7-5.1z"/>

    {%- when 'brilho' -%}
